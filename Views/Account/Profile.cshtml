@model TodoManagementSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "Profil Ayarları";
    Layout = "_UserLayout";
}

<div class="row">
    <div class="col-md-12">
        <div class="card mb-4">
            <h5 class="card-header">Profil Detayları</h5>
            
            <!-- Profil Fotoğrafı Yükleme ve Silme Alanı -->
            <div class="card-body">
                <div class="d-flex align-items-start align-items-sm-center gap-4">
                    <!-- Mevcut Fotoğrafı Göster -->
                    @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                    {
                        <img src="@Model.ProfilePicturePath" alt="user-avatar" class="d-block rounded" height="100" width="100" style="object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/sneat/assets/img/avatars/1.png" alt="user-avatar" class="d-block rounded" height="100" width="100" />
                    }

                    <div class="button-wrapper">
                        <!-- Fotoğraf Yükleme Formu -->
                        <form asp-controller="Account" asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" class="d-inline-block me-2 mb-2">
                            <label for="upload" class="btn btn-primary me-2" tabindex="0">
                                <span class="d-none d-sm-block">Yeni Fotoğraf Seç</span>
                                <i class="bx bx-upload d-block d-sm-none"></i>
                                <input type="file" id="upload" name="profilePicture" class="account-file-input" hidden accept="image/png, image/jpeg" onchange="this.form.submit()" />
                            </label>
                        </form>

                        <!-- Fotoğraf Silme Formu -->
                        @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                        {
                            <form asp-controller="Account" asp-action="RemoveProfilePicture" method="post" class="d-inline-block mb-2">
                                <button type="submit" class="btn btn-outline-secondary account-image-reset">
                                    <i class="bx bx-reset d-block d-sm-none"></i>
                                    <span class="d-none d-sm-block">Sıfırla</span>
                                </button>
                            </form>
                        }
                        <p class="text-muted mb-0">İzin verilen formatlar: JPG, GIF veya PNG. (MAX 3MB)</p>
                    </div>
                </div>
            </div>
            
            <hr class="my-0">
            
            <!-- Kullanıcı Bilgilerini Güncelleme Formu -->
            <div class="card-body">
                <form asp-controller="Account" asp-action="UpdateProfileInfo" method="post">
                    <div class="row">
                        <div class="mb-3 col-md-6">
                            <label class="form-label">E-Posta Adresi (Kullanıcı Adı)</label>
                            <input class="form-control" type="text" value="@Model.Email" readonly disabled />
                            <small class="text-muted">E-posta adresi değiştirilemez.</small>
                        </div>
                        <div class="mb-3 col-md-6">
                            <label for="firstName" class="form-label">Adınız</label>
                            <input class="form-control" type="text" id="firstName" name="firstName" value="@Model.FirstName" placeholder="Adınızı girin" />
                        </div>
                        <div class="mb-3 col-md-6">
                            <label for="lastName" class="form-label">Soyadınız</label>
                            <input class="form-control" type="text" id="lastName" name="lastName" value="@Model.LastName" placeholder="Soyadınızı girin" />
                        </div>
                        <div class="mb-3 col-md-6">
                            <label for="bio" class="form-label">Hakkımda</label>
                            <textarea class="form-control" id="bio" name="bio" rows="3" placeholder="Kendinizden biraz bahsedin...">@Model.Bio</textarea>
                        </div>
                    </div>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-success me-2">
                            <i class="bx bx-save me-1"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
            
        </div>
    </div>
</div>